# Azure Configuration
# Both agents use the same OpenAI v1 compatible endpoint
AZUREAI_BASE_URL=https://your-resource.openai.azure.com/
AZUREAI_API_KEY=your_azure_api_key_here

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Orchestrator Backend Selection
# Options: "azure" or "ollama"
ORCHESTRATOR_BACKEND=azure

# Model Selection
CODING_AGENT_MODEL=gpt-4.1-mini
ORCHESTRATOR_MODEL=DeepSeek-V3.1

# Agent Configuration
ORCHESTRATOR_TEMPERATURE=0.7
CODING_AGENT_TEMPERATURE=0.2
MAX_ORCHESTRATOR_ITERATIONS=10

# Include conversation context when calling coding agent
# Set to "true" if orchestrator assumes coding agent has memory of previous subtasks
# This will pass all previously generated code as context to each new coding agent call
INCLUDE_CONVERSATION_CONTEXT=true
